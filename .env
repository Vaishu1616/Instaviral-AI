# ─────────────────────────────────────────
#  InstaViral AI — Environment Variables
# ─────────────────────────────────────────

# Groq API Key (free at console.groq.com)
GROQ_API_KEY=###################################################

# MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017

# Database name
DB_NAME=instaviral

# Temp folder for video processing
TEMP_DIR=./temp
UPLOAD_DIR=./uploads

# Max video file size in MB
MAX_VIDEO_SIZE_MB=100

# FastAPI settings
API_HOST=0.0.0.0
API_PORT=8000
